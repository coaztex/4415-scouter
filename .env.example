# Copy to .env.local for local development. Never commit populated environment files.
# Use a modern sb_publishable_ key from the Supabase project Connect dialog.

# Public Supabase configuration; required for authentication and app data.
# A publishable key is not a replacement for database RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only TBA Read API v3 key from https://www.thebluealliance.com/account
# Required for TBA import/sync. Set in local .env.local and the Vercel project.
# Never prefix this with NEXT_PUBLIC_.
TBA_AUTH_KEY=

# Optional Nexus pit addresses and map geometry. Server-only; no browser calls.
NEXUS_API_KEY=

# Optional live TBA updates. Defaults to 300 seconds when unset (range 60-3600).
TBA_REFRESH_INTERVAL_SECONDS=300
# Optional TBA webhook HMAC secret. Set the same random value in your TBA account.
TBA_WEBHOOK_SECRET=

# Server only; required for username login, admin account operations, and webhooks.
# Use the legacy service_role JWT from the Supabase project API Keys page.
# Never expose in client code, props, responses, or logs.
SUPABASE_SERVICE_ROLE_KEY=

# No AI provider key or app-base URL is used by this implementation.
