# Copy to .env.local. Both public values are required to use Supabase; the placeholder shell works without them.
# Local secrets are ignored. Use a modern sb_publishable_ key from the project Connect dialog.

# Public Supabase configuration; required when Supabase integration begins.
# A publishable key is not a replacement for database RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only TBA Read API v3 key from https://www.thebluealliance.com/account
# Set in local .env.local and Vercel server environments; not Supabase settings.
# Never prefix this with NEXT_PUBLIC_.
TBA_AUTH_KEY=

# Optional live TBA updates. Defaults to 300 seconds when unset (range 60-3600).
TBA_REFRESH_INTERVAL_SECONDS=300
# Optional TBA webhook HMAC secret. Set the same random value in your TBA account.
TBA_WEBHOOK_SECRET=

# Server only; required for username login (email login uses the public key).
# Use the legacy service_role JWT from the Supabase project API Keys page.
# Never expose in client code, props, responses, or logs.
SUPABASE_SERVICE_ROLE_KEY=


